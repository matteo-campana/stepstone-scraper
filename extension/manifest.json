{
  "manifest_version": 3,
  "name": "StepStone Scraper & Matcher",
  "version": "1.0.0",
  "description": "Estrae gli annunci dalle pagine di ricerca StepStone e calcola l'affinità con il tuo profilo.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.stepstone.de/*",
    "https://www.stepstone.at/*",
    "https://www.stepstone.be/*",
    "https://www.stepstone.nl/*",
    "https://www.stepstone.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StepStone Scraper & Matcher",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.stepstone.de/*",
        "https://www.stepstone.at/*",
        "https://www.stepstone.be/*",
        "https://www.stepstone.nl/*",
        "https://www.stepstone.fr/*"
      ],
      "js": ["selectors.js", "match.js", "companies.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
